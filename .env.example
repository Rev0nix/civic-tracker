# ==============================================================================
# Lokify Environment Configuration Template
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit .env or .env.local containing real secrets to Git.
# ==============================================================================

# Supabase Platform (Backend Database & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Maps Platform (Browser API key with HTTP Referrer & API restrictions)
# IMPORTANT: In Google Cloud Console, restrict this key:
# 1. Application restrictions -> Websites / HTTP referrers:
#    - https://your-domain.github.io/*
#    - http://localhost:*
#    - capacitor://localhost
#    - http://localhost
# 2. API restrictions:
#    - Maps JavaScript API
#    - Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key_here
VITE_GOOGLE_MAPS_MAP_ID=016089-E20F62-171E41

# Firebase Authentication (Official Google Sign-In Provider)
# Obtain these from your Firebase Project Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
